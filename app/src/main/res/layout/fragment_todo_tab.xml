<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 날짜 요약 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/bg_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbAchievement"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/calendar_green"
            android:progressBackgroundTint="@color/divider" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- TODO 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTodos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 새 항목 추가 폼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/bg_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etNewName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="새 항목 이름"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="추가"
                android:textSize="14sp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <!-- 옵션 chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                app:chipStartPadding="4dp"
                app:chipEndPadding="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNormalTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일반 타이머"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                app:chipStartPadding="4dp"
                app:chipEndPadding="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSetTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="세트 타이머"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                app:chipStartPadding="4dp"
                app:chipEndPadding="4dp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- URL 입력 -->
        <EditText
            android:id="@+id/etNewUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://"
            android:textSize="14sp"
            android:inputType="textUri"
            android:visibility="gone"
            android:background="@drawable/bg_input_field"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="8dp" />

        <!-- 일반 타이머 목표 시간 -->
        <LinearLayout
            android:id="@+id/layoutNormalTimerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목표 시간 (분, 선택):"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etGoalMinutes"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="없음"
                android:textSize="14sp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

        </LinearLayout>

        <!-- 세트 타이머 입력 -->
        <LinearLayout
            android:id="@+id/layoutSetTimerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="운동 (초)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="휴식 (초)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="세트 수"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etWorkSeconds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="30"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/etRestSeconds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="10"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/etSetCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="3"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
