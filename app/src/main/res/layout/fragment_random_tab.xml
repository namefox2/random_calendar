<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- 분류 선택 (스크롤 가능) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="분류 선택"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/tvSelectedPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:textSize="13sp"
        android:textColor="@color/primary"
        android:visibility="gone" />

    <!-- 선택 개수 + 랜덤돌리기 버튼 (항상 고정 노출) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_primary">

        <TextView
            android:id="@+id/tvCountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선택 개수:"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etPickCount"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="3"
            android:inputType="number"
            android:gravity="center"
            android:textSize="15sp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnPickRandom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="랜덤 돌리기"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPickedItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyPick"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="분류를 선택하고 '랜덤 돌리기'를 눌러주세요"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:visibility="visible" />

    <Button
        android:id="@+id/btnAddToTodo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TODO에 추가"
        android:layout_margin="12dp"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
