<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="파스텔 테마"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <!-- 테마 선택 버튼 행 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPink"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🌸 핑크"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#F48FB1"
                android:textColor="#880E4F"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/btnBlue"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🩵 파랑"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#90CAF9"
                android:textColor="#0D47A1"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/btnGreen"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🌿 녹색"
                android:backgroundTint="#A5D6A7"
                android:textColor="#1B5E20"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <!-- 테마 선택 버튼 행 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnYellow"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🌼 노랑"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#FFF59D"
                android:textColor="#E65100"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/btnBlack"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🖤 블랙"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- 빈 공간 -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- 미리보기 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="미리보기"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/previewBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <View
                android:id="@+id/previewSidebar"
                android:layout_width="56dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/previewMain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/previewText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="슬로건 텍스트"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:id="@+id/previewAccent"
                android:layout_width="56dp"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- 색상 스와치 -->
        <LinearLayout
            android:id="@+id/colorSwatches"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp" />

        <!-- 적용/초기화 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="기본값 초기화"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="적용"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
